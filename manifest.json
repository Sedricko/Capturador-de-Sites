{
	"manifest_version": 3,
	"key": "",
	"name": "Capturador de Sites",
	"version": "6.0.1",
	"description": "Visita as páginas de um site uma a uma e salva o site completo para navegar offline.",
	"permissions": ["downloads", "scripting", "declarativeNetRequest", "storage", "offscreen", "debugger", "contextMenus", "notifications", "unlimitedStorage", "alarms"],
	"host_permissions": ["<all_urls>"],
	"background": { "service_worker": "background.js", "type": "module" },
	"icons": { "128": "icone.png" },
	"action": { "default_title": "Capturar site a partir desta página", "default_icon": "icone.png" }
}
